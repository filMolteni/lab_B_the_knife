@startuml
autonumber

actor Gestore

participant GRV as "GestoreRistorantiView"
participant GRC as "GestoreRistorantiController"
participant RFV as "RistoranteFormView"
participant RFC as "RistoranteFormController"
participant S as "Server"
participant DB as "Database"

== Apertura Gestione ==
Gestore -> GRV : apre gestione
GRV -> GRC : initHandlers()
GRC -> S : REQUEST_RIEPILOGO
S -> DB : SELECT ristoranti
DB --> S : lista
S --> GRC : RIEPILOGO_OK
GRC -> GRV : loadRiepilogo()

== Aggiunta ==
Gestore -> GRV : clicca Aggiungi
GRV -> GRC : apriFormAggiunta()
GRC -> RFC : crea controller
RFC -> RFV : creaLayout()

Gestore -> RFV : inserisce dati
Gestore -> RFV : clicca Salva

RFV -> RFC : salva()
RFC -> S : RISTORANTE_ADD
S -> DB : INSERT
DB --> S : OK
S --> RFC : ADD_OK
RFC -> GRC : onSuccess()
GRC -> GRV : loadRiepilogo()

== Modifica ==
Gestore -> GRV : clicca Modifica
GRV -> GRC : apriFormModifica()
GRC -> RFC : crea controller
RFC -> RFV : setValues()

Gestore -> RFV : modifica dati
Gestore -> RFV : clicca Salva

RFV -> RFC : salva()
RFC -> S : RISTORANTE_UPDATE
S -> DB : UPDATE
DB --> S : OK
S --> RFC : UPDATE_OK
RFC -> GRC : onSuccess()
GRC -> GRV : loadRiepilogo()

== Eliminazione ==
Gestore -> GRV : clicca Elimina
GRV -> GRC : eliminaRistorante()
GRC -> S : RISTORANTE_DELETE
S -> DB : DELETE
DB --> S : OK
S --> GRC : DELETE_OK
GRC -> GRV : loadRiepilogo()

@enduml
