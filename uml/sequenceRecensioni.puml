@startuml
autonumber
skinparam sequenceMessageAlign center
skinparam participantPadding 20
skinparam boxPadding 20

actor Utente

participant "RistoranteDettagliView" as RDV
participant "RistoranteDettagliController" as RDC
participant "ScriviRecensioneView" as SRV
participant "ScriviRecensioneController" as SRC
participant "Server" as S
participant "Database" as DB

== Apertura form recensione ==
Utente -> RDV : clicca "Scrivi Recensione"
RDV -> RDC : onScriviRecensione()
RDC -> SRC : new ScriviRecensioneController(idRistorante, onSuccess)
SRC -> SRV : initHandlers()

== Inserimento dati ==
Utente -> SRV : inserisce testo e voto
Utente -> SRV : clicca "Invia"

== Invio recensione ==
SRV -> SRC : inviaRecensione()
SRC -> S : RECENSIONE_NUOVA(idRistorante, voto, testo)

== Salvataggio ==
S -> DB : INSERT INTO recensioni (...)
DB --> S : OK

== Aggiornamento UI ==
S --> SRC : RECENSIONE_OK
SRC -> RDC : onSuccess()
RDC -> RDV : aggiornaRecensioni()

@enduml
