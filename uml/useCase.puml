@startuml
left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome

actor Utente
actor Gestore
actor "Utente Non Autenticato" as Guest

rectangle "Sistema Ristoranti" {

  ' --- AUTENTICAZIONE ---
  Guest --> (Registrarsi)
  Guest --> (Effettuare Login)
  Utente --> (Effettuare Logout)

  ' --- RICERCA RISTORANTI ---
  Utente --> (Cercare Ristorante)
  Utente --> (Filtrare per Tipo Cucina)
  Utente --> (Filtrare per Prezzo)
  Utente --> (Filtrare per Città)
  Utente --> (Visualizzare Dettagli Ristorante)

  ' --- RECENSIONI ---
  Utente --> (Scrivere Recensione)
  Utente --> (Modificare Recensione)
  Utente --> (Eliminare Recensione)
  Utente --> (Visualizzare Recensioni Utente)
  Utente --> (Visualizzare Recensioni Ristorante)

  ' --- PREFERITI ---
  Utente --> (Aggiungere ai Preferiti)
  Utente --> (Visualizzare Preferiti)

  ' --- GESTORE ---
  Gestore --> (Gestire Ristoranti)
  Gestore --> (Aggiungere Ristorante)
  Gestore --> (Modificare Ristorante)
  Gestore --> (Eliminare Ristorante)
  Gestore --> (Visualizzare Recensioni Ricevute)
  Gestore --> (Rispondere a Recensione)

  ' --- RELAZIONI INTERNE ---
  (Gestire Ristoranti) --> (Aggiungere Ristorante)
  (Gestire Ristoranti) --> (Modificare Ristorante)
  (Gestire Ristoranti) --> (Eliminare Ristorante)

  (Scrivere Recensione) --> (Visualizzare Dettagli Ristorante)
  (Rispondere a Recensione) --> (Visualizzare Recensioni Ricevute)
}

@enduml
