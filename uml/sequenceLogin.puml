@startuml
autonumber
skinparam sequenceMessageAlign center
skinparam participantPadding 20
skinparam boxPadding 20

actor Utente

participant "ClientMain" as CM
participant "LoginController" as LC
participant "LoginView" as LV
participant "Server" as S
participant "Database" as DB

== Avvio schermata Login ==
Utente -> CM : clicca "Login"
CM -> LC : mostraLogin()
LC -> LV : initHandlers()

== Inserimento credenziali ==
Utente -> LV : inserisce email e password
Utente -> LV : clicca "Accedi"

== Invio richiesta ==
LV -> LC : doLogin()
LC -> S : LOGIN_REQUEST(email, password)

== Validazione ==
S -> DB : query SELECT * FROM utenti WHERE email=...
DB --> S : risultato utente

alt credenziali valide
    S --> LC : LOGIN_OK
    LC -> CM : onLoginSuccess()
    CM -> CM : mostraHome()
else credenziali errate
    S --> LC : LOGIN_FAIL
    LC -> LV : mostraErrore("Credenziali non valide")
end

@enduml
