SET SQL_MODE = "NO_AUTO_VALUE_ON_ZERO";
START TRANSACTION;
SET time_zone = "+00:00";

DROP TABLE IF EXISTS preferiti;
DROP TABLE IF EXISTS risposte;
DROP TABLE IF EXISTS recensioni;
DROP TABLE IF EXISTS RistorantiTheKnife;
DROP TABLE IF EXISTS utenti;

-- ============================
-- TABELLA UTENTI
-- ============================
CREATE TABLE utenti (
  id INT NOT NULL AUTO_INCREMENT,
  nome VARCHAR(100) NOT NULL,
  email VARCHAR(100) NOT NULL,
  password VARCHAR(100) NOT NULL,
  ruolo VARCHAR(20) NOT NULL,
  PRIMARY KEY (id),
  UNIQUE KEY email (email)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

-- ============================
-- TABELLA RISTORANTI (SPECIFICA UFFICIALE)
-- ============================
CREATE TABLE RistorantiTheKnife (
  id INT NOT NULL AUTO_INCREMENT,
  nome VARCHAR(150) NOT NULL,
  nazione VARCHAR(100) NOT NULL,
  citta VARCHAR(100) NOT NULL,
  indirizzo VARCHAR(200) NOT NULL,
  latitudine DOUBLE NOT NULL,
  longitudine DOUBLE NOT NULL,
  fascia_prezzo INT NOT NULL,
  delivery BOOLEAN NOT NULL DEFAULT FALSE,
  prenotazione BOOLEAN NOT NULL DEFAULT FALSE,
  tipo_cucina VARCHAR(100) NOT NULL,
  PRIMARY KEY (id)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

-- ============================
-- TABELLA RECENSIONI
-- ============================
CREATE TABLE recensioni (
  id INT NOT NULL AUTO_INCREMENT,
  id_utente INT NOT NULL,
  id_ristorante INT NOT NULL,
  voto INT CHECK (voto BETWEEN 1 AND 5),
  testo TEXT NOT NULL,
  PRIMARY KEY (id),
  KEY id_utente (id_utente),
  KEY id_ristorante (id_ristorante),
  CONSTRAINT recensioni_ibfk_1 FOREIGN KEY (id_utente) REFERENCES utenti (id) ON DELETE CASCADE,
  CONSTRAINT recensioni_ibfk_2 FOREIGN KEY (id_ristorante) REFERENCES RistorantiTheKnife (id) ON DELETE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

-- ============================
-- TABELLA RISPOSTE (GESTORE)
-- ============================
CREATE TABLE risposte (
  id INT NOT NULL AUTO_INCREMENT,
  id_recensione INT NOT NULL,
  testo TEXT NOT NULL,
  PRIMARY KEY (id),
  KEY id_recensione (id_recensione),
  CONSTRAINT risposte_ibfk_1 FOREIGN KEY (id_recensione) REFERENCES recensioni (id) ON DELETE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

-- ============================
-- TABELLA PREFERITI
-- ============================
CREATE TABLE preferiti (
  id_utente INT NOT NULL,
  id_ristorante INT NOT NULL,
  PRIMARY KEY (id_utente, id_ristorante),
  KEY id_ristorante (id_ristorante),
  CONSTRAINT preferiti_ibfk_1 FOREIGN KEY (id_utente) REFERENCES utenti (id) ON DELETE CASCADE,
  CONSTRAINT preferiti_ibfk_2 FOREIGN KEY (id_ristorante) REFERENCES RistorantiTheKnife (id) ON DELETE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

COMMIT;
